# Optional Vite env. Copy to .env.local — do not commit secrets.

# Assistant "Find a practitioner" CTA. Vite redirects /find-a-practitioner → /practitioners.
VITE_FINDER_URL=https://predictiv.co.za/practitioners

# Public backend. If unset, src/integrations/supabase/env.ts falls back to the
# linked supabase.com project (zpddlphtoeluytrejioj) so production keeps working
# until Lovable Cloud is enabled. After cutover, set these to the Cloud URL and
# anon JWT. The anon key is public. Never add SUPABASE_SERVICE_ROLE_KEY here.
# See docs/MIGRATION_TO_LOVABLE_CLOUD.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
