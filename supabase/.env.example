# Optional secrets for hosted Edge Functions (set in the Supabase/Lovable
# dashboard). Do not put real values in git.

# If set to a random string of at least 16 characters, create-practitioner
# accepts JSON { "invite_token": "<same value>", "email", "password" }.
# If unset, only a signed-in Predictiv admin (is_blog_admin) may call it.
PRACTITIONER_INVITE_TOKEN=
